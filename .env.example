# ───────────────────────────────────────────────────────────────────────────
# Bare Roots Content Portal — environment
# Copy to `.env` for local dev (netlify dev reads it). In production, add every
# one of these under Netlify → Site configuration → Environment variables.
# ───────────────────────────────────────────────────────────────────────────

# ---- Access -----------------------------------------------------------------
# Iisha & Sabrina enter CLIENT_PIN. Fred & Azaiah enter STUDIO_PIN.
# 4–8 digits each. They must be different.
CLIENT_PIN=2468
STUDIO_PIN=97531

# Names offered on the "who's here" step, comma-separated.
CLIENT_NAMES=Iisha,Sabrina
STUDIO_NAMES=Fred,Azaiah

# Any long random string. Signs the session token kept on each device.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Backblaze B2 (file storage) --------------------------------------------
# From Backblaze → Application Keys → "Add a New Application Key".
B2_KEY_ID=
B2_APP_KEY=
# The bucket you created (private). Name must be globally unique on Backblaze.
B2_BUCKET=bareroots-portal
# Shown on the bucket page as "Endpoint", e.g. s3.us-east-005.backblazeb2.com
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# The region is the middle of the endpoint, e.g. us-east-005
B2_REGION=us-east-005

# Origins allowed to upload/download directly from the browser (CORS).
# Comma-separated. Include your Netlify URL and the local dev URL.
PORTAL_ORIGINS=http://localhost:8888,http://localhost:5173,https://YOUR-SITE.netlify.app

# ---- Metadata store ----------------------------------------------------------
# "blobs" (default) uses Netlify Blobs — nothing to set up.
# "b2" keeps the JSON index files inside the B2 bucket instead.
META_STORE=blobs

# ---- Limits ------------------------------------------------------------------
# Largest single upload accepted, in MB. B2 single-request uploads cap at 5 GB.
MAX_UPLOAD_MB=4000
# Soft storage budget shown to the studio (free tier is 10 GB).
STORAGE_BUDGET_GB=10
