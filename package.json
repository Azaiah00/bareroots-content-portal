{
  "name": "bare-roots-content-portal",
  "private": true,
  "version": "1.0.0",
  "description": "Bare Roots x Couture House Co. content portal — raw footage drop-off, finished content delivery, posting calendar and ideas board.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "netlify dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p netlify/tsconfig.json",
    "setup:b2": "node scripts/setup-b2.mjs",
    "check:env": "node scripts/check-env.mjs",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@netlify/blobs": "^11.1.4",
    "@netlify/functions": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "s3rver": "^3.7.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
